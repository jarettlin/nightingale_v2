# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Supabase → Connect → "Session pooler" URI (works on IPv4 networks).
# Looks like: postgresql://postgres.<project_ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Encrypts message content before it reaches the database. Generate with:
#   .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it makes stored messages unreadable, so keep a copy somewhere safe.
MESSAGE_ENCRYPTION_KEY=
