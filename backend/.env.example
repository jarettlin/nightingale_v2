# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Supabase → Connect → "Session pooler" URI (works on IPv4 networks).
# Looks like: postgresql://postgres.<project_ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Encrypts message content before it reaches the database. Generate with:
#   .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it makes stored messages unreadable, so keep a copy somewhere safe.
MESSAGE_ENCRYPTION_KEY=

# Public project URL (not a secret): used to fetch Supabase Auth signing keys
SUPABASE_URL=https://<project_ref>.supabase.co
# Only for older projects that sign tokens with a shared secret (Settings → API → JWT secret)
SUPABASE_JWT_SECRET=
# Public anon/publishable key (browser-safe). Used by the frontend and scripts/smoke_auth.py
SUPABASE_ANON_KEY=
# Comma-separated frontend origins allowed to call the API
FRONTEND_ORIGINS=http://localhost:5173
# Which clinic row this server serves
CLINIC_SLUG=sunrise

# OpenAI (platform.openai.com → API keys). Only redacted text is ever sent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Admin only: lets scripts/add_staff.py invite staff (Supabase → Project Settings → API Keys → secret key).
# It bypasses every security rule. Never put it in the frontend or commit it. The API server doesn't need it.
SUPABASE_SECRET_KEY=

# Where patient links (/r/<token>) point
FRONTEND_URL=http://localhost:5173
# Social comment webhook (Meta app → Webhooks). Without them the webhook rejects everything.
META_APP_SECRET=
META_VERIFY_TOKEN=
# Shared secret your lead form sends in the X-Webhook-Secret header
LEAD_FORM_SECRET=
